{
    "name": "wpcalibrate/wpcalibrate-invoice-studio",
    "description": "Professional invoice creation, management, PDF generation, and payment studio for WordPress and WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "WPCalibrate",
            "email": "support@wpcalibrate.com",
            "homepage": "https://wpcalibrate.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "dompdf/dompdf": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "WPCalibrate\\InvoiceStudio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPCalibrate\\InvoiceStudio\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {}
    }
}
